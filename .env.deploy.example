# Credenciales de despliegue por FTP/FTPS (copiar como .env.deploy; NUNCA versionar).
# Uso: .\deploy.ps1   (ver README.md)

FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
# Carpeta remota donde vive la raíz del proyecto Laravel (ej. /public_html o /laravel).
FTP_REMOTE_PATH=
# true = FTPS explícito (AUTH TLS). Recomendado: el FTP simple envía la contraseña sin cifrar.
FTP_SECURE=true

# Opcional. true si el dominio apunta a FTP_REMOTE_PATH (ej. /public_html) en lugar de a su
# subcarpeta public/. Sube un .htaccess raíz que redirige todo a public/ y bloquea el resto.
DEPLOY_ROOT_HTACCESS=false
