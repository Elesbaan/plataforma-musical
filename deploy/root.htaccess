# ---------------------------------------------------------------------------
# .htaccess RAÍZ — solo para hosting donde el dominio apunta a la carpeta del
# proyecto (ej. /public_html) en lugar de a /public_html/public.
#
# deploy.ps1 lo sube como .htaccess cuando DEPLOY_ROOT_HTACCESS=true.
# Todo el tráfico se sirve desde public/; el código, .env, vendor y storage
# nunca son accesibles desde la web.
# ---------------------------------------------------------------------------

Options -Indexes

# Bloquea archivos ocultos (.env, .git, .htaccess, etc.).
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Defensa adicional: 403 a carpetas y archivos del proyecto fuera de public/.
    RewriteRule ^(app|bootstrap|config|database|lang|resources|routes|storage|tests|vendor|deploy|node_modules)(/|$) - [F,L]
    RewriteRule ^(artisan|composer\.json|composer\.lock|package\.json|package-lock\.json|vite\.config\.js|phpunit\.xml|README\.md|AGENTS\.md|CLAUDE_MASTER_SPEC\.md)$ - [F,L]

    # Todo lo demás se atiende desde public/ (las URLs no muestran /public).
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
