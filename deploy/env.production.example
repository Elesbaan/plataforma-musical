# Plantilla del .env de PRODUCCIÓN (Ferozo/DonWeb).
# Crea el archivo .env en la raíz del proyecto en el servidor (junto a artisan) con estos
# valores. Este archivo NUNCA se sube con deploy.ps1 ni se versiona con datos reales.

APP_NAME="Colectivo Musical"
APP_ENV=production
# Genera la clave en tu equipo con:  php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Mexico_City
APP_URL=https://tudominio.mx

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Base de datos MySQL/MariaDB creada en el panel de Ferozo.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sesión del panel: 30 minutos de inactividad y expira al cerrar el navegador.
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Sin procesos persistentes en hosting compartido: los correos se envían al momento.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Correo SMTP (cuenta creada en Ferozo o proveedor externo).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Videos subidos por bloques (MB).
MEDIA_MAX_VIDEO_MB=500

# SSR de Inertia desactivado (no hay Node.js en el servidor).
INERTIA_SSR_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
